# =====================================================================
# 前端公开配置（可进入浏览器 bundle）
# 仅在 .env.local 中填写真实值；.env.local 已在 .gitignore，不要 commit。
# =====================================================================
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# =====================================================================
# !!! 警告 !!!
# 以下变量绝对不能写入本文件、.env.local 或 vite.config.ts 的 define。
# 它们必须仅通过 `supabase secrets set` 写入 Edge Function 环境。
# 在前端写入后会进入静态 bundle，攻击者可以直接读取。
# =====================================================================
#
# 推荐客户安装路径：OpenAI-only
# OCR_PROVIDER=openai
# USE_OPENAI_VISION=true
# VISION_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MONTHLY_LIMIT=300
# VISION_FETCH_TIMEOUT_MS=90000
# VISION_FETCH_RETRIES=0
#
# 可选旧路径：腾讯 OCR + Qwen/DeepSeek
# OCR_PROVIDER=tencent
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_OCR_REGION=ap-guangzhou
# TENCENT_OCR_ACTION=GeneralBasicOCR
# TENCENT_OCR_LANGUAGE=may
# OCR_FREE_MONTHLY_LIMIT=900
#
# AI_REPAIR_PROVIDER=deepseek
# VISION_REPAIR_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_MONTHLY_LIMIT=500
#
# VISION_PROVIDER=qwen
# DASHSCOPE_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# QWEN_VL_MODEL=qwen3.6-plus
# VISION_MONTHLY_LIMIT=100
#
# # 推荐：Edge Function 上线后将 CORS 收紧到部署域名
# CORS_ORIGIN=https://your-frontend.example.com
#
# SUPABASE_SERVICE_ROLE_KEY 由 Supabase Edge Runtime 自动注入，不要手动设置。
